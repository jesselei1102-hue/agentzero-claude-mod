#!/bin/sh
# AgentZero launcher: runs this workspace's own runtime (src/) with a Python that has PyYAML.
#
#   ./a0 memory hot-set --scope project --hints "<task keywords>"
#   ./a0 knowledge add <path> --type raw --name "<what it is>"
#   ./a0 skills list
#   ./a0 --which        show the Python and the command it would run
#
# It runs from the workspace root, so paths are relative to the workspace. Without it
# the same command is: PYTHONPATH=src python3 -m <memory|knowledge|skills> ...
# (Windows: a0.cmd.) Generated by the framework; do not edit — see SETTLED #71.

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
cache="$here/memory/traces/a0.python"

usage() {
    echo "usage: ./a0 memory|knowledge|skills <command> [args...]   (./a0 --which)" >&2
    exit 2
}

has_yaml() {
    "$1" -c 'import sys, yaml; sys.exit(sys.version_info < (3, 11))' >/dev/null 2>&1
}

pick() {
    if [ -n "$AGENTZERO_PYTHON" ] && has_yaml "$AGENTZERO_PYTHON"; then
        echo "$AGENTZERO_PYTHON"; return 0
    fi
    if [ -r "$cache" ]; then
        cached=$(cat "$cache")
        if [ -n "$cached" ] && has_yaml "$cached"; then
            echo "$cached"; return 0
        fi
    fi
    for candidate in python3 python /usr/bin/python3 /opt/homebrew/bin/python3 \
        /usr/local/bin/python3 /Library/Frameworks/Python.framework/Versions/Current/bin/python3
    do
        found=$(command -v "$candidate" 2>/dev/null) || continue
        if has_yaml "$found"; then
            (mkdir -p "$(dirname "$cache")" && echo "$found" > "$cache") 2>/dev/null
            echo "$found"; return 0
        fi
    done
    # None has PyYAML: run the first Python anyway, so the command itself says how to fix it.
    command -v python3 2>/dev/null || command -v python 2>/dev/null || return 1
}

[ $# -gt 0 ] || usage
python=$(pick) || { echo "a0: no Python found on this machine; AgentZero needs Python 3.11+" >&2; exit 1; }

if [ "$1" = "--which" ]; then
    echo "workspace: $here"
    echo "python:    $python"
    echo "runs:      cd $here && PYTHONPATH=src $python -m <memory|knowledge|skills> ..."
    exit 0
fi

case "$1" in
    memory|knowledge|skills) ;;
    *) usage ;;
esac

cd "$here" || exit 1
PYTHONPATH="$here/src${PYTHONPATH:+:$PYTHONPATH}" exec "$python" -m "$@"
